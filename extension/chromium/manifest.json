{
  "manifest_version": 3,
  "name": "Crazy Download Manager Integration",
  "short_name": "Crazy DM",
  "version": "0.1.0",
  "description": "Send downloads, links and streaming videos to Crazy Download Manager.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["downloads", "contextMenus", "cookies", "storage", "webRequest", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Crazy Download Manager",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "crazy-download-manager@example.org", "strict_min_version": "121.0" }
  }
}
